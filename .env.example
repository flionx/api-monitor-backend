NODE_ENV=development
PORT=5000

# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/api_monitor

# At least 32 random characters
JWT_SECRET=replace-me-with-a-long-random-secret

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Set to false to disable the background heartbeat worker
WORKER_ENABLED=true

# Lets monitors target localhost / private networks.
# Dev only: The app refuses to start with this enabled in production.
ALLOW_PRIVATE_TARGETS=false