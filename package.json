{
    "name": "api-monitor-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "db:push": "drizzle-kit push",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\""
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "dotenv": "^18.0.4",
        "drizzle-orm": "^0.45.3",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "p-limit": "^7.3.3",
        "pg": "^8.23.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.2",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "prettier": "^3.9.9",
        "tsc-alias": "^1.9.7",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@11.23.0"
}
